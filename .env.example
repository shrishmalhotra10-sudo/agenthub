# Copy to .env.local and fill in. Never commit .env.local.

# Safe for the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — never prefix these with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AGENTHUB_ENCRYPTION_KEY=
AGENTHUB_SIGNING_KEY=

# Optional: leave blank to use the free demo model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
